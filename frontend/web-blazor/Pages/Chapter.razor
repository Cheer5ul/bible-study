@page "/chapter"
@inject HttpClient HttpClient

<PageTitle>Chapter</PageTitle>

<h1>Read book chapters from the Bible</h1>

<form @onsubmit="LoadChapter">
     <label for="bookName">Book Name</label>
     <input id="bookName" @bind="bookName" type="text" placeholder="Genesis"/>
     
     <label for="chapterNumber">Chapter</label>
     <input id="chapterNumber" @bind="chapterNumber" type="number"placeholder="1"/>
     
     <button type="submit">Load Chapter</button>
</form>


@if (error is not null)
{
     <p style="color: red">@error</p>
}

@if (chapterDto is not null)
{
     <h3>@chapterDto.BookName @chapterDto.Chapter</h3>
     @foreach (var verse in chapterDto.Verses)
     {
          <p><b>@verse.VerseNumber</b> @verse.Text</p>
     }
}

@code
{
     private ChapterDto? chapterDto;
     private string? error;
     private string?bookName;
     private int? chapterNumber;

     private async Task LoadChapter()
     {
          try
          {
               chapterDto = await HttpClient.GetFromJsonAsync<ChapterDto>
                    ($"api/Chapter?TranslationAbbrev=ASV&Book={bookName}&Chapter={chapterNumber}");
          }
          catch (Exception ex)
          {
               error = ex.Message;
          }
     }
}
