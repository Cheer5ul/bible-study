@page "/"
@inject TranslationApiClient TranslationApiClient

<PageTitle>Read The Bible Online</PageTitle>

<h1>Select a translation</h1>

<input @bind="_translationAbbr" placeholder="ASV"/>
<button @onclick="LoadBookNames">Load Books</button>

@if (_exception is not null)
{   
    <p style="color: red">@_exception</p>
}

@if (_errors is not null)
{
    @foreach (var error in _errors)
    {
        <p style="color: red">@error.Description</p>
    }
}

@if (_bookNames is not null)
{
    @foreach (var book in _bookNames)
    {
        <p>
            <button @onclick="() => LoadAllChapters(_translationAbbr, book)">
                @book
            </button>
        </p>
        @if (_selectedBook == book && _chaptersOfBook is not null)
        {
            @foreach (var chapter in Enumerable.Range(1, _chaptersOfBook.Value))
            {
                <button @onclick="() => LoadChapterContentsAsync(_translationAbbr, book, chapter)">
                    Chapter @chapter
                </button>
                @if (_selectedBook == book && _chaptersOfBook is not null)
                {
                    @foreach (var verse in _verses)
                    {
                        <p>@verse.VerseNumber : @verse.Text</p>
                    }
                }
            } 
        }
    }
}

@code
{
    private List<string>? _bookNames;
    private string? _exception;
    private string? _translationAbbr;
    private IReadOnlyList<ErrorResponse>? _errors;
    private int? _chaptersOfBook;
    private string? _selectedBook;
    private int? _selectedChapter;
    private IReadOnlyList<VerseLineDto?>? _verses;

    private async Task LoadBookNames()
    {
        try
        {
            var response = await TranslationApiClient.GetAllBookNamesAsync(_translationAbbr);

            if (response.books != null)
            {
                _bookNames = response.books;
                _errors = null;
                _exception = null;
            }
            else
            {
                _errors = response.problemDetails?.Errors;
            }
        }
        catch (Exception exception)
        {
            _exception = exception.Message;
        }
    }

    private async Task LoadAllChapters(string? translationAbbrev, string? book)
    {
        try
        {
            var response = await TranslationApiClient.GetChapterCountAsync(translationAbbrev, book);

            if (response.chapters != null)
            {
                _selectedBook = book;
                _chaptersOfBook = response.chapters;
                _errors = null;
                _exception = null;
            }
            else
            {
                _errors = response.problemDetails?.Errors;
            }
        }
        catch(Exception exception)
        {
            _exception = exception.Message;
        }
    }

    private async Task LoadChapterContentsAsync(string? translationAbbrev, string? book, int? chapter)
    {
        try
        {
            var response = await TranslationApiClient.GetChapterContentsAsync(
                translationAbbrev, book, chapter);

            if (response.chapter != null)
            {
                _selectedBook = book;
                _selectedChapter = chapter;
                _verses = response.chapter.Verses;
                _errors = null;
                _exception = null;
            }
            else
            {
                _errors = response.problemDetails?.Errors;
            }
        }
        catch (Exception exception)
        {
            _exception = exception.Message;
        }
    }
}
